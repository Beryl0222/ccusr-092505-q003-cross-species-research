{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "远缘细胞研究证据流水领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "BATCH_REGISTERED",
        "ANNOTATION_LOCKED",
        "ANALYSIS_STARTED",
        "REVIEW_REVOKED",
        "CLAIM_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "specimen_batch",
        "annotation_revision",
        "analysis_run",
        "research_claim"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
